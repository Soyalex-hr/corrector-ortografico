{
  "manifest_version": 3,
  "name": "Corrector para WhatsApp Web",
  "version": "2.0.0",
  "description": "Subraya los errores de ortografía y gramática mientras escribes en WhatsApp Web y te sugiere cómo corregirlos.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.languagetool.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}